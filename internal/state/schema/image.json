{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plumb.invalid/schema/doc/image.json",
  "title": "Image",
  "description": "A base image that Plumb imports into Proxmox as a template.",
  "type": "object",
  "required": [
    "kind",
    "name",
    "spec"
  ],
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "Image"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9.-]{0,61}[a-z0-9])?$",
      "description": "Unique per kind. Lower case letters, digits, '-' and '.'."
    },
    "spec": {
      "type": "object",
      "required": [
        "type",
        "url",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 100
        },
        "type": {
          "enum": [
            "vm",
            "lxc"
          ],
          "description": "Target kind that this image is for."
        },
        "url": {
          "type": "string",
          "pattern": "^https://",
          "maxLength": 2048,
          "description": "Download address of the official cloud image."
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Pinned checksum of the download. Plumb refuses any other file."
        }
      }
    }
  }
}
