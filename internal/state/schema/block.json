{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plumb.invalid/schema/doc/block.json",
  "title": "Block",
  "description": "A reusable bundle of resources with typed parameters.",
  "type": "object",
  "required": [
    "kind",
    "name",
    "spec"
  ],
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "Block"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9.-]{0,61}[a-z0-9])?$",
      "description": "Unique per kind. Lower case letters, digits, '-' and '.'."
    },
    "spec": {
      "type": "object",
      "required": [
        "resources"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "params": {
          "type": "object",
          "default": {
            "type": "object",
            "properties": {}
          },
          "required": [
            "properties"
          ],
          "properties": {
            "type": {
              "const": "object"
            },
            "properties": {
              "type": "object"
            },
            "required": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "description": "JSON Schema (2020-12) of the parameters. It must describe an object. Titles and defaults drive the UI form."
        },
        "resources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 1,
            "additionalProperties": {
              "type": "object"
            },
            "description": "Exactly one entry: resource type \u2192 attributes. String values are Go text/template strings over the parameters."
          },
          "description": "Resources in apply order."
        }
      }
    }
  }
}
