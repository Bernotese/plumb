{
  "name": "plumb-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "gen": "openapi-typescript ../api/openapi.yaml --default-non-nullable=false --empty-objects-unknown --output src/lib/api.gen.ts",
    "check:api": "node scripts/check-openapi.mjs ../api/openapi.yaml",
    "dev": "npm run gen && vite",
    "build": "npm run gen && vite build && touch dist/.gitkeep",
    "test": "npm run gen && vitest run",
    "lint": "npm run check:api && npm run gen && eslint . && prettier --check . && svelte-check --fail-on-warnings",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@redocly/openapi-core": "1.34.24",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tsconfig/svelte": "5.0.8",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.24.1",
    "globals": "17.14.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  }
}
