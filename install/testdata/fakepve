#!/usr/bin/env bash
# Fake Proxmox commands for install_test.go. One script, many names. It logs
# every call to $FAKE_STATE/calls and keeps a tiny state in $FAKE_STATE.
set -u
name=$(basename "$0")
st=$FAKE_STATE
printf '%s %s\n' "$name" "$*" >>"$st/calls"
# FAKE_FAIL: a call that starts with this text fails (a run that stops halfway).
if [[ -n ${FAKE_FAIL:-} && "$name $*" == "$FAKE_FAIL"* ]]; then
	echo "fakepve: $FAKE_FAIL failed" >&2
	exit 1
fi
has() { [[ -e $st/$1 ]]; }
list() { # list PREFIX KEY: JSON list of {KEY: name} for files PREFIX.*
	local first=1 f
	printf '['
	for f in "$st/$1".*; do
		[[ -e $f ]] || continue
		[[ $first == 1 ]] || printf ','
		first=0
		printf '{"%s":"%s"}' "$2" "${f##*/"$1".}"
	done
	printf ']\n'
}
case $name in
pveversion) echo "pve-manager/${FAKE_PVE_VERSION:-9.1.2}/0123456789abcdef (running kernel: 6.14.8-2-pve)" ;;
dpkg-query)
	case ${!#} in
	qemu-server) printf '%s' "${FAKE_QEMU_SERVER:-9.2.15}" ;;
	libpve-storage-perl) printf '%s' "${FAKE_STORAGE_PERL:-9.1.16}" ;;
	*) exit 1 ;;
	esac
	;;
dpkg) # dpkg --print-architecture | dpkg --compare-versions A ge B
	if [[ $1 == --print-architecture ]]; then
		echo amd64
		exit 0
	fi
	[[ $(printf '%s\n%s\n' "$2" "$4" | sort -V | head -n1) == "$4" ]]
	;;
hostname)
	if [[ ${1:-} == -d ]]; then echo "${FAKE_HOST_DOMAIN:-}"; else echo pve1; fi
	;;
stat) # stat -c '%U %a' -- DIR: the tests run as a normal user; root unless FAKE_DIR_OWNER
	if [[ ${2:-} != '%U %a' ]]; then exec /usr/bin/stat "$@"; fi
	printf '%s %s\n' "${FAKE_DIR_OWNER:-root}" "$(/usr/bin/stat -c %a -- "${!#}")"
	;;
systemctl) ;; # the call is in $st/calls
mountpoint) [[ ${FAKE_MOUNTED:-0} == 1 ]] ;;
ip) echo "5: vmbr0    inet 192.0.2.5/24 brd 192.0.2.255 scope global vmbr0\\       valid_lft forever preferred_lft forever" ;;
install)
	args=()
	while [[ $# -gt 0 ]]; do
		case $1 in
		-o | -g) shift ;;
		*) args+=("$1") ;;
		esac
		shift
	done
	exec /usr/bin/install "${args[@]}"
	;;
pveum)
	case "$1 $2" in
	"pool list") list pool poolid ;;
	"pool add") touch "$st/pool.$3" ;;
	"pool delete") rm -f "$st/pool.$3" ;;
	"role list")
		first=1
		printf '['
		for f in "$st"/role.*; do
			[[ -e $f ]] || continue
			[[ $first == 1 ]] || printf ','
			first=0
			# FAKE_ROLE_APPEND=1: modify appends, like a PVE that does not replace.
			printf '{"roleid":"%s","privs":"%s"}' "${f##*/role.}" "$(tr -d '\n' <"$f")"
		done
		printf ']\n'
		;;
	"role add") echo "$5" >"$st/role.$3" ;;
	"role modify")
		if [[ ${FAKE_ROLE_APPEND:-0} == 1 && -e $st/role.$3 ]]; then
			printf '%s,Sys.Modify\n' "$5" >"$st/role.$3"
		else
			echo "$5" >"$st/role.$3"
		fi
		;;
	"role delete") rm -f "$st/role.$3" ;;
	"user list")
		first=1
		printf '['
		for f in "$st"/user.*; do
			[[ -e $f ]] || continue
			[[ $first == 1 ]] || printf ','
			first=0
			printf '{"userid":"%s","groups":"%s"}' "${f##*/user.}" "${FAKE_USER_GROUPS:-}"
		done
		printf ']\n'
		;;
	"user add") touch "$st/user.$3" ;;
	"user delete") rm -f "$st/user.$3" ;;
	"acl modify" | "acl delete")
		op=$2 path=$3 ugid="" role="" type="" prop=1
		set -- "${@:4}"
		while [[ $# -gt 0 ]]; do
			case $1 in
			--users) ugid=$2 type=user ;;
			--tokens) ugid=$2 type=token ;;
			--roles) role=$2 ;;
			--propagate) prop=$2 ;;
			esac
			shift 2
		done
		# Like Proxmox: an ACL needs an existing user or token. This holds
		# for delete too, so the lines of a removed token cannot go.
		if [[ $type == token ]] && ! has "token.${ugid#*!}"; then
			echo "ACL update failed: no such token '${ugid#*!}' for user '${ugid%%!*}'" >&2
			exit 255
		fi
		if [[ $op == modify && $type == user ]] && ! has "user.$ugid"; then
			echo "ACL update failed: no such user '$ugid'" >&2
			exit 255
		fi
		touch "$st/acl"
		# One entry per path, ugid and role; the propagate flag is kept.
		awk -v p="$path" -v u="$ugid" -v r="$role" -v t="$type" '!($1 == p && $2 == u && $3 == r && $4 == t)' "$st/acl" >"$st/acl.new"
		mv "$st/acl.new" "$st/acl"
		if [[ $op == modify ]]; then echo "$path $ugid $role $type $prop" >>"$st/acl"; fi
		;;
	"acl list")
		[[ ${FAKE_ACL_FAIL:-0} == 1 ]] && exit 1
		touch "$st/acl"
		if [[ -n ${FAKE_EXTRA_ACL:-} && ! -e $st/extra-done ]]; then
			echo "$FAKE_EXTRA_ACL" >>"$st/acl"
			touch "$st/extra-done"
		fi
		first=1
		printf '['
		while read -r path ugid role type prop; do
			[[ -n $path ]] || continue
			# Like PVE 9.2: the lines of a removed token stay in user.cfg,
			# but the list skips them ("ignore invalid acl token").
			if [[ $type == token ]] && ! has "token.${ugid#*!}"; then continue; fi
			[[ $first == 1 ]] || printf ','
			first=0
			printf '{"path":"%s","ugid":"%s","roleid":"%s","type":"%s","propagate":%s}' "$path" "$ugid" "$role" "$type" "${prop:-1}"
		done <"$st/acl"
		printf ']\n'
		;;
	"user token")
		case $3 in
		list) list token tokenid ;;
		add)
			touch "$st/token.$5"
			printf '{"full-tokenid":"%s!%s","info":{"privsep":1},"value":"%s"}\n' "$4" "$5" "$FAKE_SECRET"
			;;
		remove)
			# Like PVE 9.2.26 (T-122 F4): the ACL lines of the token stay, and
			# a new token with the same name gets them again.
			rm -f "$st/token.$5"
			;;
		esac
		;;
	*) echo "fakepve: unknown pveum $*" >&2; exit 2 ;;
	esac
	;;
pvesm)
	case $1 in
	status)
		has "storage.$3" || exit 1
		# Like pvesm status: a header, then name type status total used avail %.
		state=active
		[[ ${FAKE_STORAGE_INACTIVE:-} == "$3" ]] && state=inactive
		printf 'Name Type Status Total Used Available %%\n%s %s %s 100 10 90 10.00%%\n' "$3" "$(cat "$st/type.$3" 2>/dev/null || echo dir)" "$state"
		;;
	add)
		id=$3
		touch "$st/storage.$id"
		echo "$2" >"$st/type.$id"
		while [[ $# -gt 0 ]]; do
			if [[ $1 == --content ]]; then echo "$2" >"$st/content.$id"; fi
			if [[ $1 == --path ]]; then echo "$2" >"$st/path.$id"; fi
			shift
		done
		;;
	set)
		echo "${*:2}" >>"$st/storage-set"
		# Like Proxmox (host G0): the content list is stored reordered.
		if [[ ${3:-} == --content ]]; then
			tr , '\n' <<<"$4" | sort -r | paste -sd, - >"$st/content.$2"
		fi
		;;
	remove) rm -f "$st/storage.$2" "$st/content.$2" "$st/type.$2" "$st/path.$2" ;;
	list) # pvesm list STORAGE --vmid ID: volumes left in $st/vol.*
		for f in "$st"/vol.*; do
			[[ -e $f ]] && cat "$f"
		done
		;;
	free) grep -lxF "$2 rootdir" "$st"/vol.* 2>/dev/null | xargs -r rm -f ;;
	esac
	;;
pvesh)
	case "$2" in
	/storage/*)
		id=${2#/storage/}
		if [[ -e $st/type.$id ]]; then
			# Like Proxmox: content, path, shared and type of a dir storage.
			# extra.ID: more options, for example "nodes":"pve2".
			extra=""
			[[ -e $st/extra.$id ]] && extra=",$(cat "$st/extra.$id")"
			printf '{"content":"%s","digest":"85e2","path":"%s","shared":0,"storage":"%s","type":"%s"%s}\n' \
				"$(cat "$st/content.$id")" "$(cat "$st/path.$id")" "$id" "$(cat "$st/type.$id")" "$extra"
		elif [[ -e $st/content.$id ]]; then
			printf '{"content":"%s"}\n' "$(cat "$st/content.$id")"
		elif [[ $id == local-lvm ]]; then
			echo '{"content":"images,rootdir"}'
		elif [[ $id == local ]]; then
			echo '{"content":"iso,vztmpl,backup,snippets"}'
		else
			exit 1
		fi
		;;
	/nodes/*/network)
		# The node network: network holds the JSON list; by default vmbr0
		# and the VLAN-aware vmbr9 (C8) and a plain vmbr1.
		[[ ${FAKE_NETWORK_FAIL:-0} == 1 ]] && exit 1
		if [[ -e $st/network ]]; then cat "$st/network"; else
			echo '[{"iface":"vmbr0","type":"bridge"},{"iface":"vmbr9","type":"bridge","bridge_vlan_aware":1},{"iface":"vmbr1","type":"bridge"},{"iface":"eno1","type":"eth"}]'
		fi
		;;
	/nodes/*/storage/*/content)
		# The backup volumes of a storage: backups.ID holds the JSON list.
		id=${2#/nodes/*/storage/}
		id=${id%/content}
		[[ ${FAKE_CONTENT_FAIL:-0} == 1 ]] && exit 1
		if [[ -e $st/backups.$id ]]; then cat "$st/backups.$id"; else echo '[]'; fi
		;;
	/cluster/nextid) echo 105 ;;
	/pools)
		[[ ${FAKE_POOLS_FAIL:-0} == 1 ]] && exit 1
		echo "${FAKE_POOL_MEMBERS:-[{\"poolid\":\"plumb\",\"members\":[]}]}"
		;;
	*) exit 1 ;;
	esac
	;;
pveam)
	case $1 in
	list)
		if has tmpl; then
			# The real list holds every architecture that was downloaded.
			echo "local:vztmpl/debian-13-standard_13.1-2_amd64.tar.zst 128.00MB"
			echo "local:vztmpl/debian-13-standard_13.1-2_arm64.tar.zst 121.00MB"
		fi
		;;
	# The real list has one entry per architecture; arm64 sorts after amd64.
	available) printf 'system          debian-12-standard_12.7-1_amd64.tar.zst\nsystem          debian-13-standard_13.1-2_amd64.tar.zst\nsystem          debian-13-standard_13.1-2_arm64.tar.zst\n' ;;
	update) ;;
	download) touch "$st/tmpl" ;;
	esac
	;;
pct)
	case $1 in
	status)
		has "lxc.$2" || exit 2
		if has "stopped.$2"; then echo "status: stopped"; else echo "status: running"; fi
		;;
	create)
		id=$2
		umask >"$st/create-umask"
		if [[ $(umask) != 0022 ]]; then
			# Like Proxmox: tar as the mapped root cannot enter a 0700 rootfs.
			echo "tar: /var/lib/lxc/$id/rootfs: Cannot open: Permission denied" >&2
			exit 2
		fi
		shift 2
		host="" desc="" mp="" net=""
		while [[ $# -gt 0 ]]; do
			case $1 in
			--hostname) host=$2 ;;
			--description) desc=$2 ;;
			--mp0) mp=$2 ;;
			--net0) net=$2 ;;
			esac
			shift
		done
		printf 'hostname: %s\ndescription: %s\nnet0: %s\n' "$host" "$desc" "$net" >"$st/lxc.$id"
		touch "$st/stopped.$id" # a new container is stopped
		if [[ -n $mp ]]; then
			# local-lvm:1,mp=… becomes local-lvm:vm-ID-disk-1,mp=…
			vol="${mp%%:*}:vm-$id-disk-1"
			printf 'mp0: %s,%s\n' "$vol" "${mp#*,}" >>"$st/lxc.$id"
			if [[ ${FAKE_KEEP_VOLUME:-0} == 1 ]]; then
				# A PVE whose pct destroy leaves the volume behind.
				echo "$vol rootdir" >"$st/vol.$id"
			fi
		fi
		;;
	config) cat "$st/lxc.$2" ;;
	start) rm -f "$st/stopped.$2" ;;
	stop) touch "$st/stopped.$2" ;;
	destroy)
		# A destroy that leaves the container (review nit test).
		[[ ${FAKE_DESTROY_NOOP:-0} == 1 ]] && exit 0
		rm -f "$st/lxc.$2" "$st/key.$2" "$st/stopped.$2" "$st/db.$2"
		# Like pve-container 6.1: --purge keeps rules.seccomp and passthrough/.
		if [[ -n ${PLUMB_INSTALL_LXC_DIR:-} ]]; then
			mkdir -p "$PLUMB_INSTALL_LXC_DIR/$2/passthrough"
			echo "seccomp rules" >"$PLUMB_INSTALL_LXC_DIR/$2/rules.seccomp"
		fi
		;;
	push)
		mkdir -p "$st/push"
		dst=${4//\//_}
		# Like pve-container 6.1: onto a running binary the push fails with
		# "Text file busy" and still exits 0. FAKE_PUSH_FAIL=<dest> makes any
		# push to that path (or to its temp name) fail the same way.
		fail=${FAKE_PUSH_FAIL:-}
		if { [[ $4 == /usr/local/bin/plumb && -e $st/running-exe ]] ||
			{ [[ -n $fail ]] && [[ $4 == "$fail" || $4 == "${fail%/*}/.${fail##*/}.plumb-new" ]]; }; }; then
			echo "failed to create file: $4: Text file busy" >&2
			exit 0
		fi
		cp "$3" "$st/push/$dst"
		echo "${*:5}" >"$st/push/$dst.opts"
		;;
	pull) printf -- '-----BEGIN CERTIFICATE-----\nMIIBfakePlumbCA\n-----END CERTIFICATE-----\n' >"$4" ;;
	exec)
		id=$2
		shift 3 # pct exec ID --
		# T-132: record a terminal on any std stream (lxc-attach would
		# give the command a pty in the container).
		if [[ -t 0 || -t 1 || -t 2 ]]; then echo "$*" >>"$st/exec-tty"; fi
		if [[ -t 0 || -p /dev/stdin ]]; then IFS= read -r _ || true; fi
		[[ -n ${FAKE_EXEC_FAIL:-} && "$*" == "$FAKE_EXEC_FAIL" ]] && exit 3
		case "$*" in
		"hostname -I") echo "2001:db8::50 192.0.2.50" ;;
		"dd if="*)
			# A file of the fake LXC in $st/ct/ID/PATH; iflag=nofollow
			# refuses a link, like GNU dd.
			f=$st/ct/$id/${2#if=}
			[[ -L $f && "$*" == *iflag=nofollow* ]] && { echo "dd: failed to open '${2#if=}': Too many levels of symbolic links" >&2; exit 1; }
			[[ -f $f ]] || { echo "dd: failed to open '${2#if=}': No such file or directory" >&2; exit 1; }
			cat "$f"
			;;
		"/usr/sbin/runuser -u plumb -- /usr/local/bin/plumb backup now --data /var/lib/plumb")
			[[ ${FAKE_BACKUP_NOW_FAIL:-0} == 1 ]] && exit 1
			touch "$st/backup-now"
			;;
		"test -s /etc/plumb/plumb.env") [[ -e $st/push/_etc_plumb_plumb.env ]] ;;
		"grep -q ^"*" /etc/plumb/plumb.env") grep -q "$3" "$st/push/_etc_plumb_plumb.env" ;;
		"grep -qx "*" /etc/plumb/plumb.env") grep -qxF "$3" "$st/push/_etc_plumb_plumb.env" ;;
		"test -s /var/lib/plumb/key/master.key") has "key.$id" ;;
		"test -s /var/lib/plumb/plumb.db") has "db.$id" ;;
		"mountpoint -q /var/lib/plumb/key") grep -q '^mp0: .*mp=/var/lib/plumb/key' "$st/lxc.$id" ;;
		journalctl*) echo "First start. User: admin  Password: pw-from-journal" ;;
		"sha256sum /proc/"*"/exe")
			[[ -e $st/running-exe ]] || exit 1
			sha256sum <"$st/running-exe" | sed "s#-\$#${2}#"
			;;
		"sha256sum "*)
			f=$st/push/${2//\//_}
			[[ -e $f ]] || { echo "sha256sum: $2: No such file or directory" >&2; exit 1; }
			sha256sum <"$f" | sed "s#-\$#${2}#"
			;;
		"timeout "*" systemctl is-system-running --wait")
			echo "is-system-running" >>"$st/boot-wait"
			echo "${FAKE_BOOT_STATE:-running}"
			[[ ${FAKE_BOOT_STATE:-running} == running ]]
			;;
		"mv -f "*)
			[[ ${FAKE_MV_FAIL:-0} == 1 ]] && exit 1
			from=$st/push/${3//\//_} to=$st/push/${4//\//_}
			mv -f "$from" "$to" || exit 1
			[[ -e $from.opts ]] && mv -f "$from.opts" "$to.opts"
			echo "mv $3 $4" >>"$st/mv"
			# FAKE_MV_HUP_ONCE=<dest>: the mv ran, then pct exec reports
			# SIGHUP (exit 129) once, like T-122 F7.
			if [[ ${FAKE_MV_HUP_ONCE:-} == "$4" && ! -e $st/mv-hup ]]; then
				touch "$st/mv-hup"
				exit 129
			fi
			;;
		"rm -f "*) rm -f "$st/push/${3//\//_}" "$st/push/${3//\//_}.opts" ;;
		"rm -rf -- /var/lib/plumb-restore")
			rm -f "$st/push/_var_lib_plumb-restore_"*
			echo "$*" >>"$st/rm-restore"
			;;
		"systemctl restart plumb.service")
			# FAKE_SIGNAL_ON_RESTART=HUP: the installer gets the signal
			# during the restart, like an SSH drop (review M1 of T-077).
			# pct is its direct child.
			[[ -n ${FAKE_SIGNAL_ON_RESTART:-} ]] && kill -s "$FAKE_SIGNAL_ON_RESTART" "$PPID"
			# The service now runs the binary that is in place, unless
			# FAKE_RESTART_OLD=1 (a restart that keeps the old process).
			if [[ ${FAKE_RESTART_OLD:-0} != 1 && -e $st/push/_usr_local_bin_plumb ]]; then
				cp "$st/push/_usr_local_bin_plumb" "$st/running-exe"
			fi
			;;
		"systemctl show -p MainPID --value plumb.service")
			# FAKE_CRASH_LOOP=1: a new process at every read, like a unit
			# that systemd restarts every few seconds.
			n=$(cat "$st/restarts" 2>/dev/null || echo 0)
			[[ ${FAKE_CRASH_LOOP:-0} == 1 ]] && { n=$((n + 1)); echo "$n" >"$st/restarts"; }
			if [[ -e $st/running-exe ]]; then echo $((4242 + n)); else echo 0; fi
			;;
		"systemctl show -p NRestarts --value plumb.service") cat "$st/restarts" 2>/dev/null || echo 0 ;;
		"systemctl is-active plumb.service")
			if [[ ${FAKE_CRASH_LOOP:-0} == 1 ]]; then echo activating; exit 3; fi
			echo active
			;;
		*) ;;
		esac
		;;
	esac
	;;
lxc-attach) # lxc-attach -n ID --clear-env -- runuser -u plumb -- plumb key init …
	# The key prompts keep the real terminal (D-180).
	if [[ -t 0 ]]; then echo "${*:5}" >>"$st/attach-tty"; fi
	[[ ${FAKE_KEYINIT_FAIL:-0} == 1 ]] && exit 1
	if [[ "${*:5}" == "/usr/sbin/runuser -u plumb -- /usr/local/bin/plumb key restore --data /var/lib/plumb" ]]; then
		has "key.$2" && exit 1
		touch "$st/key.$2"
	fi
	if [[ "${*:5}" == "/usr/sbin/runuser -u plumb -- /usr/local/bin/plumb restore --data /var/lib/plumb --from /var/lib/plumb-restore/restore.pbk" ]]; then
		[[ ${FAKE_RESTORE_FAIL:-0} == 1 ]] && exit 1
		[[ -e $st/push/_var_lib_plumb-restore_restore.pbk ]] || exit 1
		# Like plumb restore (D-318): the data directory holds only the key.
		compgen -G "$st/push/_var_lib_plumb_*" >/dev/null && { echo "plumb restore: /var/lib/plumb is not empty" >&2; exit 1; }
		touch "$st/db.$2"
		echo "Restored. User: admin  Password: NEWPW"
	fi
	if [[ "${*:5}" == "/usr/sbin/runuser -u plumb -- /usr/local/bin/plumb key init --data /var/lib/plumb" ]]; then
		has "key.$2" && exit 1 # a key is never replaced
		touch "$st/key.$2"
		echo "RECOVERY KEY (shown once; Plumb stores it nowhere):"
		echo "    FAKERECOVERYKEY"
	fi
	;;
*) echo "fakepve: unknown command $name" >&2; exit 2 ;;
esac
