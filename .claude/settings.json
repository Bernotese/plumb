      "Bash(gh repo edit:*)",
      "Bash(gh repo rename:*)",
      "Bash(gh api -X DELETE:*)",
      "Bash(gh secret:*)",
      "Bash(sudo:*)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "Bash(rm -rf /home:*)",
      "Bash(lxc delete:*)",
      "Bash(mkfs:*)",
      "Read(~/.ssh/**)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.codex/auth.json)",
      "Read(~/.claude/.credentials.json)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "python3 /home/jannes/workspcae/plump/.claude/statusline.py",
    "padding": 0
  }
